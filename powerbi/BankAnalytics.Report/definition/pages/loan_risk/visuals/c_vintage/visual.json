          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Loans"
                    }
                  },
                  "Property": "Loan Count"
                }
              },
              "queryRef": "Loans.Loan Count",
              "nativeQueryRef": "Loan Count"
