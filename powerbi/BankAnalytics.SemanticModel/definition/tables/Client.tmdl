table Client
	lineageTag: ab30c70a-0c6c-457e-afb1-7ef22ac0ed1a

	column client_id
		dataType: int64
		formatString: 0
		lineageTag: dcedb8f7-530e-47af-8487-de70f06e0411
		summarizeBy: none
		sourceColumn: client_id

	column gender
		dataType: string
		lineageTag: c5468acb-3a37-4a7e-af07-c1189d1a28bb
		summarizeBy: none
		sourceColumn: gender

	column age_band
		dataType: string
		lineageTag: eb3623fd-f600-4dc7-acce-a50c260aa28d
		summarizeBy: none
		sourceColumn: age_band

	column age_at_end_1998
		dataType: int64
		formatString: 0
		lineageTag: 0500fd16-e239-47bf-a0cc-1010493a49d8
		summarizeBy: average
		sourceColumn: age_at_end_1998

	partition Client = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_clients.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Selected = Table.SelectColumns(Promoted, {"client_id", "gender", "age_band", "age_at_end_1998"}),
				    Blanks = Table.ReplaceValue(Selected, "", null, Replacer.ReplaceValue, Table.ColumnNames(Selected)),
				    Typed = Table.TransformColumnTypes(Blanks, {{"client_id", Int64.Type}, {"gender", type text}, {"age_band", type text}, {"age_at_end_1998", Int64.Type}}, "en-US")
				in
				    Typed

