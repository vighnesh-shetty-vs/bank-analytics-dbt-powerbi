table 'Monthly KPIs'
	lineageTag: b7d34864-beed-478b-9d83-e54b604c268a

	measure Inflow = SUM('Monthly KPIs'[inflow_czk])
		formatString: #,0
		lineageTag: a687fdde-6fed-4ff9-b5cd-a8c55b0f3648

	measure Outflow = SUM('Monthly KPIs'[outflow_czk])
		formatString: #,0
		lineageTag: b7bf1618-852b-41d2-aa62-cee6f7041105

	measure 'Net Flow' = [Inflow] - [Outflow]
		formatString: #,0
		lineageTag: daf44f01-0d79-43dd-a194-b612518f1916

	measure 'Transaction Count' = SUM('Monthly KPIs'[transactions])
		formatString: #,0
		lineageTag: 50ec40c8-ee4b-4113-bc6f-7b1f6d542293

	measure 'New Accounts' = SUM('Monthly KPIs'[new_accounts])
		formatString: #,0
		lineageTag: 022192ba-a28a-4c7a-ae35-5ff28ac150c3

	measure 'Active Accounts (Latest Month)' = VAR LastMonth = MAX('Monthly KPIs'[month_start]) RETURN CALCULATE(SUM('Monthly KPIs'[active_accounts]), 'Monthly KPIs'[month_start] = LastMonth)
		formatString: #,0
		lineageTag: f97fccb2-2f48-481a-8fbb-7fa60fa8246a

	measure 'Deposits (Latest Month)' = VAR LastMonth = MAX('Monthly KPIs'[month_start]) RETURN CALCULATE(SUM('Monthly KPIs'[month_end_balance_czk]), 'Monthly KPIs'[month_start] = LastMonth)
		formatString: #,0
		lineageTag: 7e9999a7-7dc9-403d-860b-07ed849caebc

	measure 'Balance per Active Account' = DIVIDE([Deposits (Latest Month)], [Active Accounts (Latest Month)])
		formatString: #,0
		lineageTag: d4e990fa-9eb9-4142-a48e-3a6d775663bc

	measure 'Inflow YoY %' = VAR PrevYear = CALCULATE([Inflow], SAMEPERIODLASTYEAR('Date'[date_day])) RETURN DIVIDE([Inflow] - PrevYear, PrevYear)
		formatString: 0.0%
		lineageTag: 134a6dac-dfc2-4b7b-a2c2-d3aa46aa1793

	measure 'Card Share of Outflow' = DIVIDE(SUM('Monthly KPIs'[card_spend_czk]), [Outflow])
		formatString: 0.00%
		lineageTag: 27917be0-bc9a-4591-b480-a89f2d037fa7

	measure 'Overdrawn Account-Month Rate' = DIVIDE(SUM('Monthly KPIs'[accounts_with_negative_balance]), SUM('Monthly KPIs'[active_accounts]))
		formatString: 0.00%
		lineageTag: c66c4e36-61e5-4f13-8c49-7bb8cec72a4c

	column month_start
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: 72444bcd-0ba2-43f3-82d4-22098123a0a6
		summarizeBy: none
		sourceColumn: month_start

	column district_id
		dataType: int64
		formatString: 0
		lineageTag: b15a0227-af5f-47d0-971c-7e1c47b65c1f
		summarizeBy: none
		sourceColumn: district_id

	column active_accounts
		dataType: int64
		formatString: #,0
		lineageTag: 6491b1f7-f1b6-4f76-9cf8-ee21e01e1711
		summarizeBy: sum
		sourceColumn: active_accounts

	column new_accounts
		dataType: int64
		formatString: #,0
		lineageTag: 329481c9-888f-4ad9-bcc0-de4c0114237b
		summarizeBy: sum
		sourceColumn: new_accounts

	column transactions
		dataType: int64
		formatString: #,0
		lineageTag: 92cb2fce-359a-4689-bd49-624411360eb0
		summarizeBy: sum
		sourceColumn: transactions

	column inflow_czk
		dataType: double
		formatString: #,0
		lineageTag: c5e591ad-202d-4621-9e2d-5cfe7df52e8f
		summarizeBy: sum
		sourceColumn: inflow_czk

	column outflow_czk
		dataType: double
		formatString: #,0
		lineageTag: e286293d-8b84-4f19-947b-209a3f77f5af
		summarizeBy: sum
		sourceColumn: outflow_czk

	column net_flow_czk
		dataType: double
		formatString: #,0
		lineageTag: 0865a667-c27b-4e58-9e96-2023ab31590c
		summarizeBy: sum
		sourceColumn: net_flow_czk

	column card_spend_czk
		dataType: double
		formatString: #,0
		lineageTag: 36b0a6cb-d71e-4dd1-95fa-fe8b9ee1475a
		summarizeBy: sum
		sourceColumn: card_spend_czk

	column month_end_balance_czk
		dataType: double
		formatString: #,0
		lineageTag: da1dfca4-dc96-43d4-b8be-4ddb1856a2d8
		summarizeBy: sum
		sourceColumn: month_end_balance_czk

	column accounts_with_negative_balance
		dataType: int64
		formatString: #,0
		lineageTag: f3d89556-f95e-4529-b651-51abb82a803d
		summarizeBy: sum
		sourceColumn: accounts_with_negative_balance

	partition 'Monthly KPIs' = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "rpt_monthly_kpis.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Selected = Table.SelectColumns(Promoted, {"month_start", "district_id", "active_accounts", "new_accounts", "transactions", "inflow_czk", "outflow_czk", "net_flow_czk", "card_spend_czk", "month_end_balance_czk", "accounts_with_negative_balance"}),
				    Blanks = Table.ReplaceValue(Selected, "", null, Replacer.ReplaceValue, Table.ColumnNames(Selected)),
				    Typed = Table.TransformColumnTypes(Blanks, {{"month_start", type date}, {"district_id", Int64.Type}, {"active_accounts", Int64.Type}, {"new_accounts", Int64.Type}, {"transactions", Int64.Type}, {"inflow_czk", type number}, {"outflow_czk", type number}, {"net_flow_czk", type number}, {"card_spend_czk", type number}, {"month_end_balance_czk", type number}, {"accounts_with_negative_balance", Int64.Type}}, "en-US")
				in
				    Typed

