model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_ProTooling = ["DevMode"]

ref table Date
ref table District
ref table Client
ref table Account
ref table Loans
ref table 'Monthly KPIs'

ref role 'Regional Manager - Prague'

