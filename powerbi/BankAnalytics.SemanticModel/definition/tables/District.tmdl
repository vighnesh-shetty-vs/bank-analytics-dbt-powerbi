table District
	lineageTag: c5223a9c-68a6-42d7-8190-0f914ccd6976

	column district_id
		dataType: int64
		formatString: 0
		lineageTag: ab2c0c06-d43b-44ea-b5ec-80f992f90231
		summarizeBy: none
		sourceColumn: district_id

	column district_name
		dataType: string
		lineageTag: a9a02314-1f09-4b26-9569-0d546f1b6c84
		summarizeBy: none
		sourceColumn: district_name

	column region
		dataType: string
		lineageTag: 40e44d3c-b6bf-485c-8ae1-96cb33fe5232
		summarizeBy: none
		sourceColumn: region

	column inhabitants
		dataType: int64
		formatString: #,0
		lineageTag: ec7202d4-6931-4f53-af24-89e94236df65
		summarizeBy: sum
		sourceColumn: inhabitants

	column avg_salary_czk
		dataType: int64
		formatString: #,0
		lineageTag: fc5c14db-072c-4284-a867-f609632ceef7
		summarizeBy: average
		sourceColumn: avg_salary_czk

	column unemployment_rate_1996_pct
		dataType: double
		formatString: 0.00
		lineageTag: 4fc5ba08-c70e-4b00-82ce-a9c683d1d7c8
		summarizeBy: average
		sourceColumn: unemployment_rate_1996_pct

	partition District = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_districts.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Selected = Table.SelectColumns(Promoted, {"district_id", "district_name", "region", "inhabitants", "avg_salary_czk", "unemployment_rate_1996_pct"}),
				    Blanks = Table.ReplaceValue(Selected, "", null, Replacer.ReplaceValue, Table.ColumnNames(Selected)),
				    Typed = Table.TransformColumnTypes(Blanks, {{"district_id", Int64.Type}, {"district_name", type text}, {"region", type text}, {"inhabitants", Int64.Type}, {"avg_salary_czk", Int64.Type}, {"unemployment_rate_1996_pct", type number}}, "en-US")
				in
				    Typed

