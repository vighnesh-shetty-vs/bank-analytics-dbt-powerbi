{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.7.0/schema.json",
  "name": "b_card",
  "position": {
    "x": 20,
    "y": 440,
    "z": 5,
    "height": 260,
    "width": 600,
    "tabOrder": 5
  },
  "visual": {
    "visualType": "clusteredBarChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Account"
                    }
                  },
                  "Property": "best_card_type"
                }
              },
              "queryRef": "Account.best_card_type",
              "nativeQueryRef": "best_card_type",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Account"
                    }
                  },
                  "Property": "Account Count"
                }
              },
              "queryRef": "Account.Account Count",
              "nativeQueryRef": "Account Count"
            }
          ]
        },
        "Legend": {
          "projections": []
        }
      }
    },
    "drillFilterOtherVisuals": true,
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Accounts by best card held'"
                }
              }
            }
          }
        }
      ]
    }
  }
}
